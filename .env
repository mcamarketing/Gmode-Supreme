# ==========================================
# 🚀 GODMODE SUPREME - FLASH LOAN MEV BOT
# ==========================================
# BSC Network with BloXroute Infrastructure
# Flash Loan Powered for Maximum Profits

# ==========================================
# 🔗 NETWORK CONFIGURATION
# ==========================================
NETWORK=bsc
CHAIN_ID=56

# BloXroute WebSocket (Primary)
RPC_URL=wss://bsc-mainnet.blxrbdn.com/ws

# Fallback HTTP RPC endpoints
FALLBACK_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc-dataseed1.defibit.io,https://bsc-dataseed1.ninicoin.io

# ==========================================
# 🔐 WALLET CONFIGURATION
# ==========================================
# Replace with your actual private key (64 hex characters)
BOT_PRIVATE_KEY=YOUR_ACTUAL_PRIVATE_KEY_HERE

# Cold wallet for profit storage (90% of profits go here)
COLD_WALLET_ADDRESS=YOUR_COLD_WALLET_ADDRESS_HERE

# ==========================================
# 📦 BLOXROUTE CONFIGURATION
# ==========================================
# Get these from https://bloxroute.com dashboard
BLOXROUTE_AUTH_HEADER=YOUR_BLOXROUTE_AUTH_HEADER_HERE
BLOXROUTE_ACCOUNT_ID=YOUR_BLOXROUTE_ACCOUNT_ID_HERE

# BloXroute Features
USE_BLOXROUTE_BUNDLE=true
ENABLE_PRIVATE_MEMPOOL=true
BLOXROUTE_MEV_SEARCHER=true
BLOXROUTE_NEXT_VALIDATOR=true
BLOXROUTE_BUNDLE_PRICE=0.001

# ==========================================
# 🏦 VENUS PROTOCOL (FLASH LOANS)
# ==========================================
# Venus Protocol addresses on BSC
VENUS_UNITROLLER=0xfD36E2c2a6789Db23113685031d7F16329158384
VENUS_VBNB=0xA07c5b74C9B40447a954e1466938b865b6BBea36

# Flash Loan Configuration
ENABLE_FLASH_LOANS=true
FLASH_LOAN_PROVIDER=venus
MAX_FLASH_LOAN_AMOUNT=1000
MIN_FLASH_LOAN_PROFIT=0.05
FLASH_LOAN_FEE=0.0009
DYNAMIC_LOAN_SIZING=true
ENABLE_FLASH_LOAN_PROFIT_VERIFICATION=true

# ==========================================
# 🔄 DEX ROUTER ADDRESSES
# ==========================================
# PancakeSwap V2
PANCAKESWAP_ROUTER_V2=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKESWAP_FACTORY_V2=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# BiSwap
BISWAP_ROUTER=0x3a6d8cA21D1CF76F653A67577FA0D27453350dD8
BISWAP_FACTORY=0x858E3312ed3A876947EA49d572A7C42DE08af7EE

# ApeSwap
APESWAP_ROUTER=0xcF0feBd3f17CEf5b47b0cD257aCf6025c5BFf3b7
APESWAP_FACTORY=0x0841BD0B734E4F5853f0dD8d7Ea041c241fb0Da6

# BakerySwap
BAKERYSWAP_ROUTER=0xCDe540d7eAFE93aC5fE6233Bee57E1270D3E330F

# MDEX
MDEX_ROUTER=0x7DAe51BD3E3376B8c7c4900E9107f12Be3AF1bA8

# BabySwap
BABYSWAP_ROUTER=0x325E343f1dE602396E256B67eFd1F61C3A6B38Bd

# ==========================================
# 💰 PROFIT SETTINGS
# ==========================================
# Minimum thresholds for flash loan operations
MIN_SWAP_USD=100
MIN_PROFIT_USD=0.05
MIN_PROFIT_PERCENTAGE=0.1

# Auto-withdrawal settings
AUTO_WITHDRAW_THRESHOLD=0.2
PROFIT_SPLIT_PERCENTAGE=90
ENABLE_AUTO_WITHDRAW=true

# ==========================================
# ⛽ GAS OPTIMIZATION
# ==========================================
# BSC gas settings (lower than Polygon)
GAS_LIMIT=300000
GAS_PRICE_GWEI=5
MAX_GAS_PRICE_GWEI=20
GAS_PREMIUM_GWEI=2.0
FAST_GAS_MULTIPLIER=1.2

# ==========================================
# 🎯 PERFORMANCE SETTINGS
# ==========================================
# Trading limits
MAX_CONCURRENT_TRADES=5
MAX_SLIPPAGE_PERCENTAGE=1
SCAN_INTERVAL=100

# Mempool filtering
FILTER_MIN_VALUE_USD=50
ENABLE_LARGE_TX_FILTER=true
LARGE_TX_THRESHOLD_USD=10000

# ==========================================
# 📊 MONITORING & LOGGING
# ==========================================
LOG_LEVEL=info
ENABLE_TELEGRAM_ALERTS=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Database
DATABASE_URL=sqlite:./data/bot.db

# API Settings
API_PORT=3001
DASHBOARD_PORT=3002
ENABLE_API=true

# ==========================================
# 🛡️ SECURITY SETTINGS
# ==========================================
ENABLE_WHITELIST=false
WHITELISTED_TOKENS=
MAX_POSITION_SIZE_BNB=50
EMERGENCY_STOP=false

# ==========================================
# 🔧 DEVELOPMENT SETTINGS
# ==========================================
NODE_ENV=production
DEBUG_MODE=false
ENABLE_SIMULATION=false
DRY_RUN=false

# ==========================================
# 📈 STRATEGY SETTINGS
# ==========================================
# Enable different strategies
ENABLE_SANDWICH_ATTACKS=true
ENABLE_ARBITRAGE=true
ENABLE_LIQUIDATION_HUNTING=true
ENABLE_TOKEN_SNIPING=true

# Strategy-specific settings
SANDWICH_MIN_IMPACT=0.5
ARBITRAGE_MIN_SPREAD=0.2
LIQUIDATION_HEALTH_THRESHOLD=1.1
SNIPER_GAS_MULTIPLIER=1.5